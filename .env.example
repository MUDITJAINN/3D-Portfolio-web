# Copy to .env for local development (Create React App reads REACT_APP_* only)

# --- Assistant ---
# Set to false to hide the floating guide panel
REACT_APP_ASSISTANT_ENABLED=true

# --- AI (optional) — put keys in .env (NOT .env.example). Restart after changes: npm start ---
#
# Groq (key starts with gsk_):
# REACT_APP_GROK_API_KEY=your_groq_key
# REACT_APP_GROK_API_URL=https://api.groq.com/openai/v1
# REACT_APP_GROK_MODEL=llama-3.3-70b-versatile
#
# xAI Grok (key from console.x.ai):
# REACT_APP_GROK_API_KEY=your_xai_key
# REACT_APP_GROK_API_URL=https://api.x.ai/v1
# REACT_APP_GROK_MODEL=grok-2-latest
#
REACT_APP_AI_RATE_LIMIT=5

# Phase 2: enable 3D robot canvas overlay
# REACT_APP_ROBOT_3D=true

# Optional text-to-speech for assistant replies
# REACT_APP_SPEECH=true

# Pause starfield / Three.js when tab is in background
REACT_APP_PAUSE_WHEN_HIDDEN=true

# Google Analytics (defaults to existing site ID if unset)
# REACT_APP_GA_ID=G-M8KTSFJJ5R
